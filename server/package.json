{
  "name": "abulkour-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live market data, news ingestion, AI news analysis and prediction API for Abulkour",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "export-seed": "tsx scripts/export-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
