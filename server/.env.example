# ------------------------------------------------------------------
# MarketPulse AI backend configuration.
# Copy to .env and fill in. API keys live ONLY here, on the backend.
# The React Native app never sees any of these values.
# ------------------------------------------------------------------

PORT=4000
DATABASE_PATH=./data/marketpulse.db

# --- Market data / news / fundamentals: Finnhub (https://finnhub.io) ---
FINNHUB_API_KEY=

# How many minutes behind real time your Finnhub plan's quotes are.
# 0 = real-time. If your plan is delayed, set the delay so the app shows
# "DELAYED" instead of pretending the quote is live.
FINNHUB_QUOTE_DELAY_MINUTES=0

# Quote polling interval (ms). Pick this from your plan's rate limit.
# Free Finnhub = 60 calls/min, so 15 symbols x every 20s = 45 calls/min.
QUOTE_POLL_INTERVAL_MS=20000

# Stream trades over Finnhub's WebSocket in addition to polling (true/false).
FINNHUB_STREAMING=true

# --- Historical candles for charts/predictions: Polygon.io / Massive ---
# Optional. Without it the Chart tab shows "Historical data unavailable".
POLYGON_API_KEY=

# --- Long daily history for training (back to 2000): Tiingo (https://www.tiingo.com), free key ---
# Without it, the model trains on Polygon's 2-year window.
TIINGO_API_KEY=

# Symbols used to train the model (defaults to ~40 large stocks/ETFs; SPY is always included)
# TRAINING_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA

# --- Extra legitimate RSS/Atom feeds (comma separated) ---
# Only add feeds whose terms allow this kind of use.
NEWS_RSS_FEEDS=

# News polling interval (ms)
NEWS_POLL_INTERVAL_MS=60000

# --- AI news analysis (Claude) ---
# Without a key, a transparent rule-based analyzer is used and labeled as such.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Watchlist used for background polling and the home screen ---
DEFAULT_WATCHLIST=AAPL,NVDA,MSFT,SPY,QQQ,JEPQ

# --- Browser origins allowed to call the API (Expo web). Native apps don't need this. ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Optional Expo push notifications for alerts ---
EXPO_PUSH_ENABLED=false
